    "plt.plot(n_values, mean, marker='o')\n",
    "plt.plot(n_values, [sackin_uniform(n) for n in n_values], marker='o', linestyle='--', label='Uniform model')\n",
    "plt.xlabel('Number of leaves (n)')\n",
